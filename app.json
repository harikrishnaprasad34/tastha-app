{
  "expo": {
    "name": "Tastha",
    "slug": "tastha-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tastha.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Tastha to find your nearby delivery area while you use the app. Confirm or edit your address before shopping."
      }
    },
    "android": {
      "versionCode": 4,
      "package": "com.tastha.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0B0E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tastha",
    "backgroundColor": "#0A0B0E",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tastha to find your approximate delivery area. You can also enter a PIN manually."
        }
      ],
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 240,
          "backgroundColor": "#0A0B0E",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
