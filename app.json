{
  "expo": {
    "name": "Tastha",
    "slug": "tastha-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/tastha-mark.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tastha.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Tastha to find your nearby delivery area while you use the app. Confirm or edit your address before shopping."
      }
    },
    "android": {
      "package": "com.tastha.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/tastha-mark.png",
        "backgroundColor": "#0A0B0E"
      },
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/tastha-mark.png"
    },
    "scheme": "tastha",
    "backgroundColor": "#0A0B0E",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tastha to find your approximate delivery area. You can also enter a PIN manually."
        }
      ],
      "expo-secure-store",
      "expo-router"
    ]
  }
}
